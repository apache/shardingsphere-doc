&lt;h4 data-hextra-search-id=&#34;configure-database-route&#34;&gt;Configure Database Route&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;configure-database-route&#34;&gt;&lt;/span&gt;&lt;a href=&#34;#configure-database-route&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h4&gt;&lt;ul&gt;
