+    dataSourceClassName: com.zaxxer.hikari.HikariDataSource
+    driverClassName: com.microsoft.sqlserver.jdbc.SQLServerDriver
+    jdbcUrl: jdbc:sqlserver://localhost:1433;databaseName=demo_ds_1;encrypt=false;
+    username: sa
