  &lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;

&lt;h3 data-hextra-search-id=&#34;使用-hint-路由至指定数据库&#34;&gt;使用 Hint 路由至指定数据库&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;使用-hint-路由至指定数据库&#34;&gt;&lt;/span&gt;&lt;a href=&#34;#%e4%bd%bf%e7%94%a8-hint-%e8%b7%af%e7%94%b1%e8%87%b3%e6%8c%87%e5%ae%9a%e6%95%b0%e6%8d%ae%e5%ba%93&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h3&gt;
